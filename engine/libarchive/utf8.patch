--- a/libarchive/archive_string.c
+++ b/libarchive/archive_string.c
@@ -453,16 +453,9 @@
 default_iconv_charset(const char *charset) {
 	if (charset != NULL && charset[0] != '\0')
 		return charset;
-#if HAVE_LOCALE_CHARSET && HAVE_LOCALCHARSET_H && !defined(__APPLE__)
-	/* locale_charset() is broken on Mac OS */
-	return locale_charset();
-#elif HAVE_NL_LANGINFO
-	return nl_langinfo(CODESET);
-#elif defined(__BIONIC__)
+/* This TAR-only application accepts UTF-8 names on every platform. Do not
+	 * consult or mutate process-global locale for archive metadata. */
 	return "UTF-8";
-#else
-	return "";
-#endif
 }
 
 #if defined(_WIN32) && !defined(__CYGWIN__)
@@ -1305,6 +1298,11 @@
 	    (flag & SCONV_TO_UTF8))
 		flag |= SCONV_NORMALIZATION_D;
 #endif
+
+	/* Preserve the application's exact UTF-8 member spelling. Canonical alias
+	 * rejection is performed separately before destination writes. */
+	if ((flag & SCONV_FROM_UTF8) && (flag & SCONV_TO_UTF8))
+		flag &= ~(SCONV_NORMALIZATION_C | SCONV_NORMALIZATION_D);
 
 #if defined(HAVE_ICONV)
 	sc->cd_w = (iconv_t)-1;
