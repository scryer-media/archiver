+/* Bounded global defaults reuse the upstream PAX record decoder and header
+ * framing. Only attributes previously supported by the application are added.
+ * Sparse and other vendor-specific global attributes remain rejected. */
+static int
+tar_metadata_charge(struct archive_read *a, struct tar *tar, int64_t size)
+{
+ if (size < 0 || (uint64_t)size > 64 * 1024 * 1024 - tar->metadata_bytes) {
+  archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+      "TAR cumulative extension metadata budget exceeded");
+  return ARCHIVE_FATAL;
+ }
+ tar->metadata_bytes += (uint64_t)size;
+ return ARCHIVE_OK;
+}
+
+static int
+tar_metadata_admit(struct archive_read *a, struct tar *tar, int64_t size)
+{
+ if (tar->metadata_headers >= 250000) {
+  archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+      "TAR extension header work budget exceeded");
+  return ARCHIVE_FATAL;
+ }
+ ++tar->metadata_headers;
+ return tar_metadata_charge(a, tar, size);
+}
+
+static int
+tar_sparse_admit(struct archive_read *a, struct tar *tar, int64_t size)
+{
+ if (size < 0 || (uint64_t)size > 1024 * 1024 - tar->sparse_metadata_bytes) {
+  archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+      "TAR sparse map metadata budget exceeded");
+  return ARCHIVE_FATAL;
+ }
+ tar->sparse_metadata_bytes += (uint64_t)size;
+ return tar_metadata_charge(a, tar, size);
+}
+
+static int
+tar_sparse_form(struct archive_read *a, struct tar *tar, unsigned form)
+{
+ unsigned conflicts = form == 1 ? (2|4|16) : form == 2 ? (1|4|8) :
+     form == 4 ? (1|2|8) : form == 8 ? (2|4|16) : (1|8);
+ if (tar->sparse_forms & conflicts) {
+  archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+      "Conflicting sparse TAR map/version attributes");
+  return ARCHIVE_FATAL;
+ }
+ tar->sparse_forms |= form;
+ return ARCHIVE_OK;
+}
+
+static int
+tar_global_key(const char *key, size_t length)
+{
+ static const char *keys[TAR_GLOBAL_KEYS] = {
+  "path", "linkpath", "size", "uid", "gid", "uname", "gname",
+  "mtime", "atime", "ctime", "hdrcharset", "SCHILY.mode"
+ };
+ for (int i = 0; i < TAR_GLOBAL_KEYS; ++i)
+  if (strlen(keys[i]) == length && memcmp(keys[i], key, length) == 0) return i;
+ return -1;
+}
+
+static int
+tar_global_number(const struct archive_string *value, int base, int64_t *number)
+{
+ int64_t n = 0;
+ if (value->length == 0) return ARCHIVE_FATAL;
+ for (size_t i = 0; i < value->length; ++i) {
+  unsigned char digit = (unsigned char)value->s[i];
+  if (digit < '0' || digit >= '0' + base) return ARCHIVE_FATAL;
+  digit -= '0';
+  if (n > (INT64_MAX - digit) / base) return ARCHIVE_FATAL;
+  n = n * base + digit;
+ }
+ *number = n;
+ return ARCHIVE_OK;
+}
+
+static void
+tar_global_time(const struct archive_string *value, int64_t *seconds, long *nanos)
+{
+ pax_time(value->s, value->length, seconds, nanos);
+ /* Upstream signs only the integral part; POSIX timestamps sign the fraction
+  * too. Normalize into the conventional floor-seconds/nonnegative-nanos pair. */
+ if (value->s[0] == '-' && *nanos > 0 && *seconds != INT64_MIN) {
+  --*seconds;
+  *nanos = 1000000000L - *nanos;
+ }
+}
+
+static int
+tar_global_validate(struct archive_read *a, int key,
+    const struct archive_string *value)
+{
+ int64_t number;
+ long nanos;
+ if (value->length && memchr(value->s, '\0', value->length) != NULL) goto invalid;
+ if (value->length == 0) return ARCHIVE_OK;
+ if (key >= 2 && key <= 4) {
+  if (tar_global_number(value, 10, &number) != ARCHIVE_OK) goto invalid;
+ } else if (key >= 7 && key <= 9) {
+  if (value->length > 128) goto invalid;
+  size_t pos = value->s[0] == '-' ? 1 : 0, digits = 0, fraction = 0;
+  while (pos < value->length && value->s[pos] >= '0' && value->s[pos] <= '9') { ++pos; ++digits; }
+  if (!digits) goto invalid;
+  if (pos < value->length && value->s[pos] == '.') {
+   ++pos;
+   while (pos < value->length && value->s[pos] >= '0' && value->s[pos] <= '9') { ++pos; ++fraction; }
+   if (!fraction) goto invalid;
+  }
+  if (pos != value->length) goto invalid;
+  tar_global_time(value, &number, &nanos);
+  if (number == INT64_MIN) goto invalid;
+ } else if (key == 10) {
+  if (value->length != 23 ||
+      memcmp(value->s, "ISO-IR 10646 2000 UTF-8", 23) != 0) goto invalid;
+ } else if (key == 11) {
+  if (tar_global_number(value, 8, &number) != ARCHIVE_OK || number > 07777) goto invalid;
+ }
+ return ARCHIVE_OK;
+invalid:
+ archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+     "Invalid or unsupported global PAX value");
+ return ARCHIVE_FATAL;
+}
+
+static int
+tar_global_apply(struct archive_read *a, struct tar *tar, struct archive_entry *entry)
+{
+ for (int key = 0; key < TAR_GLOBAL_KEYS; ++key) {
+  unsigned bit = 1U << key;
+  if (!((tar->global_present | tar->local_present) & bit)) continue;
+  const struct archive_string *value = (tar->local_present & bit) ? &tar->local_values[key] : &tar->global_values[key];
+  /* Last local record wins; an empty value suppresses the global default
+   * and leaves the base header field unset for upstream fallback. */
+  if (!value->length) continue;
+  int64_t number = 0; long nanos = 0;
+  if (tar_global_validate(a, key, value) != ARCHIVE_OK) return ARCHIVE_FATAL;
+  switch (key) {
+   case 0: if (archive_strlen(&tar->entry_pathname_override)) break; if (!archive_entry_update_pathname_utf8(entry, value->s)) { archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT, "Invalid UTF-8 global PAX text"); return ARCHIVE_FATAL; }; break;
+   case 1: if (!archive_entry_update_link_utf8(entry, value->s)) { archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT, "Invalid UTF-8 global PAX text"); return ARCHIVE_FATAL; }; break;
+   case 2:
+    tar_global_number(value, 10, &number);
+    tar->pax_size = number; tar->size_fields |= TAR_SIZE_PAX_SIZE; break;
+   case 3: tar_global_number(value, 10, &number); archive_entry_set_uid(entry, number); break;
+   case 4: tar_global_number(value, 10, &number); archive_entry_set_gid(entry, number); break;
+   case 5: if (!archive_entry_update_uname_utf8(entry, value->s)) { archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT, "Invalid UTF-8 global PAX text"); return ARCHIVE_FATAL; }; break;
+   case 6: if (!archive_entry_update_gname_utf8(entry, value->s)) { archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT, "Invalid UTF-8 global PAX text"); return ARCHIVE_FATAL; }; break;
+   case 7: tar_global_time(value, &number, &nanos); archive_entry_set_mtime(entry, number, nanos); break;
+   case 8: tar_global_time(value, &number, &nanos); archive_entry_set_atime(entry, number, nanos); break;
+   case 9: tar_global_time(value, &number, &nanos); archive_entry_set_ctime(entry, number, nanos); break;
+   case 10: tar->pax_hdrcharset_utf8 = 1; break;
+   case 11: tar_global_number(value, 8, &number); archive_entry_set_perm(entry, (mode_t)number); break;
+  }
+ }
+ return ARCHIVE_OK;
+}
