{
  "name": "archiver",
  "compatibility_date": "2026-11-01",
  "main": "./worker/index.mjs",
  // `_headers` is bundled as text so the Worker sets the same policy as the static assets.
  "rules": [{ "type": "Text", "globs": ["**/_headers"], "fallthrough": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only engine requests reach the Worker; every other path is served straight from the assets with `_headers`.
    "run_worker_first": ["/engine/*"]
  },
  "routes": [
    { "pattern": "archiver.scryer.media", "custom_domain": true }
  ]
}
